datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  password      String
  name          String
  avatar        String?
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  memberships   RoomMember[]
  createdRooms  StudyRoom[]    @relation("RoomCreator")
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")
  stats         UserStats?
  sessions      StudySession[]
  chatMessages  ChatMessage[]
  editedNotes   Note[]         @relation("NoteEditor")
}

model UserStats {
  id               String    @id @default(uuid())
  userId           String    @unique
  totalStudyHours  Float     @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  weeklyGoalHours  Float     @default(10.0)
  lastActiveDate   DateTime?
  
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyRoom {
  id            String         @id @default(uuid())
  name          String
  description   String?
  subject       String
  isPrivate     Boolean        @default(false)
  inviteCode    String         @unique
  creatorId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  creator       User           @relation("RoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members       RoomMember[]
  tasks         Task[]
  notes         Note[]
  chatMessages  ChatMessage[]
  sessions      StudySession[]
}

model RoomMember {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  role      String    @default("MEMBER") // CREATOR, MEMBER
  joinedAt  DateTime  @default(now())
  
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([roomId, userId])
}

model StudySession {
  id              String    @id @default(uuid())
  roomId          String
  userId          String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationMinutes Int       @default(0)
  type            String    @default("POMODORO") // POMODORO, SHORT_BREAK, LONG_BREAK
  createdAt       DateTime  @default(now())
  
  room            StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            String    @id @default(uuid())
  roomId        String
  title         String
  description   String?
  status        String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate       DateTime?
  assigneeId    String?
  creatorId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  room          StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
}

model Note {
  id             String    @id @default(uuid())
  roomId         String
  title          String
  content        String    @db.Text
  lastEditedById String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  room           StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lastEditedBy   User      @relation("NoteEditor", fields: [lastEditedById], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String    @id @default(uuid())
  roomId    String
  userId    String?
  message   String    @db.Text
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
